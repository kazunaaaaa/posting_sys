# ---- サーバー設定 ----
PORT=4000

# ---- Google Maps / Places ----
# 地図表示に使うキー（クライアントに渡る。HTTPリファラ制限を推奨）
# https://console.cloud.google.com/ で「Maps JavaScript API」を有効化して取得
GOOGLE_MAPS_API_KEY=

# 競合POI検索に使うキー（サーバー側でのみ使用。IP制限を推奨）
# 「Places API (New)」を有効化。未設定時はOpenStreetMap Overpassにフォールバック
GOOGLE_PLACES_API_KEY=

# ---- e-Stat（政府統計）API ----
# 市区町村の世帯数の実データ取得に使用。未設定時は世帯数 null（部数は「—」）
# https://www.e-stat.go.jp/api/ でアプリケーションID(appId)を取得
ESTAT_APP_ID=
# 市区町村別世帯数の統計表ID（国勢調査 or 住民基本台帳）
ESTAT_STATS_DATA_ID=

# ---- 境界データ ----
# 市区町村境界GeoJSONの取得元ベースURL（既定: niiyz raw GitHub / <pref2>/<code>.json 構成）
# 実運用では e-Stat 統計GIS 境界データの配信元に差し替え推奨
BOUNDARY_BASE=
# 境界簡略化の許容誤差(度)。既定 0.0004（約44m）
BOUNDARY_SIMPLIFY=

# ---- 配布会社 原価・見積 ----
# 各社の原価/見積データJSONのパス（未設定時は server/data/pricing.sample.json）
PRICING_DATA_PATH=

# ---- Claude API（最適エリアのAI解説）----
# 未設定時はスコアリング結果のみ（ルールベース解説）を返す
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
